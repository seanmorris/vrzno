 <name>vrzno</name>
 <channel>pecl.php.net</channel>
 <summary>JavaScript bridge for PHP running under Emscripten</summary>
 <description>Vrzno bridges PHP values, objects, arrays, callbacks, classes, promises, and fetch streams with JavaScript in php-wasm runtimes.</description>
 <lead>
  <name>Sean Morris</name>
  <user>seanmorris</user>
  <email>640101+seanmorris@users.noreply.github.com</email>
  <active>yes</active>
 </lead>
 <date>2026-09-04</date>
 <time>00:00:00</time>
 <version>
  <release>0.2.0</release>
  <api>0.2.0</api>
 </version>
 <stability>
  <release>beta</release>
  <api>beta</api>
 </stability>
 <license uri="https://www.apache.org/licenses/LICENSE-2.0">Apache-2.0</license>
 <notes>Defines stable null and error semantics, repairs value ownership, and supports PHP 8.0 through 8.5 on Emscripten wasm32.</notes>
